<div class="bradcaump_area" style="
    background-image: url('https://br-floral-tree-b35p9voh.storage.c-4.ap-southeast-1.aws.neon.tech/assets/images/uploads/cat.jpg');
    background-repeat: no-repeat;
    background-size: cover;
    background-position: center center;
">
  <div class="container">
    <div class="row">
      <div class="col-lg-12">
        <div class="bradcaump_inner text-center">
          <h2 class="bradcaump-title">Prescription Glasses</h2>
          <nav class="bradcaump-content">
            <a class="breadcrumb_item navi" href="/home">Home</a>
            <span id="nipa" class="brd-separetor">/</span>
            <a class="breadcrumb_item navi" href="/products">Products</a>
         
          </nav>
        </div>
      </div>
    </div>
  </div>
</div>
<!-- Start Shop Area -->
<div class="shop_area bg--white">
  <div class="container">
    <div class="row">
      <div class=" col-12 ">
        <div class="shop_product_area">
          <div class="shop-bar-area">
            <div class="shop-filter-tab d-none ">
              <div class="view_mode justify-content-center nav" role="tablist">
                <a class="active" href="#tab1" data-bs-toggle="tab"> <i class="ti-layout-grid4-alt"></i></a>
                <a class="" href="#tab2" data-bs-toggle="tab"><i class="ti-list"></i></a>
              </div>
            </div>
            <div class="shop-found-selector">
            </div>
          </div>
          <div class="tab_content">
            <div class="row single_grid_product tab-pane fade show active" id="tab1" role="tabpanel">

              <% prescription_category=data.categories.filter((c,i)=> {return c.name == 'Plano' })[0]
                          prescription_products = data.products.filter((v,i) => { return v.category_id ==
                          prescription_category.id })
                          %>
              <% prescription_products.forEach(product => { %>
              
              <!-- Start Single Product -->
              <div class="col-lg-6 col-xl-4 col-sm-6 col-12">
                <div class="product">
                  <a class="navi" href="single-product/<%= product.id %>">
                    <div class="thumb" style="
                                    height: 24vh;
                                    background-image: url('<%= data.blogUrl %>/<%= product.img_url%>');
                                    background-size: contain;
                                    background-repeat: no-repeat;
                                    background-position: center;">
                      <div class="content">
                        <h4>
                          <%= product.name %>
                        </h4>
                      </div>
                    </div>
                  </a>
                </div>
              </div>
              <!-- End Single Product -->
              <% }) %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<!-- End Shop Area -->